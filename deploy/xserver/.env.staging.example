APP_NAME="Groovy Shift System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://groovy.dev-smarty.com

APP_LOCALE=ja
APP_FALLBACK_LOCALE=ja
APP_FAKER_LOCALE=ja_JP
APP_TIMEZONE=Asia/Tokyo

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=__XSERVER_DATABASE_HOST__
DB_PORT=3306
DB_DATABASE=__XSERVER_DATABASE__
DB_USERNAME=__XSERVER_DATABASE_USER__
DB_PASSWORD=__XSERVER_DATABASE_PASSWORD__

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@dev-smarty.com"
MAIL_FROM_NAME="${APP_NAME}"

INITIAL_ADMIN_NAME="開発管理者"
INITIAL_ADMIN_EMAIL=ryota.i.0320@gmail.com
INITIAL_ADMIN_PASSWORD=__GENERATE_A_STRONG_PASSWORD__

VITE_APP_NAME="${APP_NAME}"
